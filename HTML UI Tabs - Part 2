    <!-- TAB 5: SYSTEM SETTINGS & PIN MANAGEMENT -->
    <div id="tab-settings" class="tab-content hidden relative z-10 pointer-events-none w-full h-full">
      <div id="panel-settings" class="absolute top-16 right-2 left-2 sm:left-auto sm:w-80 pointer-events-auto glass-panel p-3 flex flex-col gap-2 max-h-[82vh] overflow-y-auto">
        <div class="flex justify-between items-center border-b border-slate-800 pb-1">
          <h3 class="text-xs font-bold text-cyan-400 flex items-center gap-1"><i class="fa-solid fa-pen-to-square"></i> الإعدادات وتغيير كلمات السر</h3>
          <div class="flex items-center gap-1">
            <button onclick="toggleCollapse('panel-settings')" class="text-slate-400 hover:text-white text-xs px-1"><i class="fa-solid fa-minus"></i></button>
            <button onclick="hidePanel('panel-settings')" class="text-slate-400 hover:text-red-400 text-xs px-1"><i class="fa-solid fa-xmark"></i></button>
          </div>
        </div>
        
        <div class="panel-content space-y-3 text-xs">
          <!-- Password Change Tool (Admin Only) -->
          <div class="admin-only-container bg-slate-950 p-2 rounded border border-cyan-500/30 space-y-1.5">
            <span class="text-[10px] text-cyan-300 font-bold block"><i class="fa-solid fa-key ml-1"></i> تغيير الأرقام السرية (PIN):</span>
            <select id="changePinTarget" class="w-full bg-slate-900 border border-slate-700 p-1 rounded text-slate-200">
              <option value="admin">حساب المهندس غانم (Admin)</option>
              <option value="operator">المشرف الأمني (Operator)</option>
              <option value="viewer">حساب المراقب (Viewer)</option>
            </select>
            <input type="password" id="newPinInput" maxlength="8" placeholder="الرمز السري الجديد" class="w-full bg-slate-900 border border-slate-700 p-1 rounded text-slate-200 text-center font-mono">
            <button onclick="updateAccountPin()" class="w-full bg-cyan-600 hover:bg-cyan-500 text-white p-1 rounded font-bold">
              تحديث الرمز السري 🔑
            </button>
          </div>

          <!-- Site Info Editor (Admin Only) -->
          <div class="admin-only-container space-y-2">
            <div>
              <label class="text-[10px] text-slate-400 block mb-0.5">اسم النظام / الصفحة:</label>
              <input type="text" id="editSystemTitle" value="AegisRadar 360 AI" class="w-full bg-slate-900 border border-slate-700 p-1.5 rounded text-cyan-300 font-bold">
            </div>

            <div>
              <label class="text-[10px] text-slate-400 block mb-0.5">الأستاذ المشرف:</label>
              <input type="text" id="editSupervisor" value="إبراهيم" class="w-full bg-slate-900 border border-slate-700 p-1.5 rounded text-slate-200">
            </div>

            <div>
              <label class="text-[10px] text-slate-400 block mb-0.5">فريق العمل (الطلاب):</label>
              <input type="text" id="editStudents" value="غانم فراس | سما غسان | إبراهيم غسان" class="w-full bg-slate-900 border border-slate-700 p-1.5 rounded text-slate-200">
            </div>

            <button onclick="saveSystemSettings()" class="w-full bg-gradient-to-r from-emerald-600 to-cyan-600 hover:from-emerald-500 hover:to-cyan-500 text-white p-2 rounded font-bold shadow-lg transition">
              حفظ وتحديث البيانات 💾
            </button>
          </div>

          <div id="read-only-notice" class="hidden bg-amber-950/60 border border-amber-500/40 p-2 rounded text-amber-200 text-[10px]">
            ⚠️ أنت تسجل الدخول كـ (مشاهد/مشرف أمني). جميع الصلاحيات في وضع القراءة فقط. التعديل متاح للمهندس غانم حصراً.
          </div>
        </div>
      </div>
