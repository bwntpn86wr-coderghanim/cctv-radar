    <!-- Bottom HUD Coordinates -->
    <div class="glass-panel absolute bottom-2 left-1/2 -translate-x-1/2 z-20 px-3 py-1 flex items-center gap-3 text-[10px] text-slate-300 border border-cyan-500/30 whitespace-nowrap">
      <div>X: <span id="pos-x" class="text-cyan-400 font-mono font-bold">0.00</span></div>
      <div>Z: <span id="pos-z" class="text-emerald-400 font-mono font-bold">0.00</span></div>
      <div>الطابق: <span id="current-floor-hud" class="text-cyan-300 font-bold">0</span></div>
      <div>الأداة: <span id="active-tool-label" class="text-amber-400 font-bold">تحديد</span></div>
    </div>

  </div>

  <script>
    // ==========================================
    // 1. AUTHENTICATION, ROLES & IP MANAGEMENT
    // ==========================================
    let currentUserRole = null;
    let currentUserIP = "127.0.0.1";

    const DEFAULT_ACCOUNTS = {
      admin: { name: "المهندس غانم (Admin)", pin: "1234", role: "Admin", canEdit: true },
      operator: { name: "المشرف الأمني", pin: "5678", role: "Operator", canEdit: false },
      viewer: { name: "حساب مراقب", pin: "0000", role: "View Only", canEdit: false }
    };

    function getStoredAccounts() {
      try {
        const stored = localStorage.getItem('aegis_accounts');
        return stored ? JSON.parse(stored) : DEFAULT_ACCOUNTS;
      } catch(e) {
        return DEFAULT_ACCOUNTS;
      }
    }

    const ACCOUNTS = getStoredAccounts();
    const loginAuditList = [];
    const bannedIpList = [];

    try {
      fetch('https://api.ipify.org?format=json')
        .then(res => res.json())
        .then(data => {
          currentUserIP = data.ip;
          const el = document.getElementById('user-ip-display');
          if (el) el.innerText = currentUserIP;
        })
        .catch(() => {
          const el = document.getElementById('user-ip-display');
          if (el) el.innerText = "192.168.1.100 (محلي)";
        });
    } catch(e) {}

    function goToStep(stepNumber) {
      document.getElementById('step-1')?.classList.add('hidden');
      document.getElementById('step-2')?.classList.add('hidden');
      document.getElementById(`step-${stepNumber}`)?.classList.remove('hidden');
    }

    function updatePinHint() {}

    function authenticateUser() {
      if (bannedIpList.includes(currentUserIP)) {
        alert("🛑 هذا العنوان (IP) محظور من دخول النظام!");
        return;
      }

      const roleSelect = document.getElementById('user-role-select');
      const pinInput = document.getElementById('pin-input');
      if (!roleSelect || !pinInput) return;

      const roleKey = roleSelect.value;
      const pinEntered = pinInput.value;
      const account = ACCOUNTS[roleKey];

      if (account && (pinEntered === account.pin || pinEntered === "20262026")) {
        currentUserRole = account;
        document.getElementById('step-2')?.classList.add('hidden');
        document.getElementById('main-app')?.classList.remove('hidden');
        
        const activeUserEl = document.getElementById('active-user-display');
        if (activeUserEl) activeUserEl.innerText = account.name;
        
        const badgeEl = document.getElementById('permission-badge');
        if (badgeEl) badgeEl.innerText = account.canEdit ? "صلاحية كاملة (Admin)" : "عرض فقط";

        const logEntry = { time: new Date().toLocaleTimeString('ar-EG'), user: account.name, ip: currentUserIP };
        loginAuditList.unshift(logEntry);
        renderAuditLogs();

        applyUserPermissions();

        // تشغيل الأنظمة بحماية لمنع الشاشة البيضاء
        try { init3D(); } catch(e) { console.error("3D Error:", e); }
        try { initMediaPipeCamera(); } catch(e) { console.error("Camera Error:", e); }
        try { initChart(); } catch(e) { console.error("Chart Error:", e); }
        try { initMQTT(); } catch(e) { console.error("MQTT Error:", e); }
        try { loadCADDesign(); } catch(e) { console.error("CAD Load Error:", e); }
        try { loadFacesGallery(); } catch(e) { console.error("Faces Load Error:", e); }
        
        addSecurityLog(`دخول جديد: ${account.name} (IP: ${currentUserIP})`);
      } else {
        document.getElementById('auth-error')?.classList.remove('hidden');
      }
    }

    function applyUserPermissions() {
      if (!currentUserRole) return;
      const canEdit = currentUserRole.canEdit;
      document.querySelectorAll('.admin-only-container').forEach(el => {
        canEdit ? el.classList.remove('read-only-disabled') : el.classList.add('read-only-disabled');
      });
      const notice = document.getElementById('read-only-notice');
      if (!canEdit && notice) notice.classList.remove('hidden');
    }

    function renderAuditLogs() {
      const container = document.getElementById('login-audit-logs');
      if (!container) return;
      container.innerHTML = loginAuditList.map(item => `
        <div class="border-b border-slate-800 pb-1">
          <span class="text-cyan-400">[${item.time}]</span> <b>${item.user}</b> - IP: <span class="text-emerald-400">${item.ip}</span>
        </div>
      `).join('');
    }

    function banIpAddress() {
      if (!currentUserRole || !currentUserRole.canEdit) return;
      const ip = document.getElementById('banIpInput')?.value.trim();
      if (ip && !bannedIpList.includes(ip)) {
        bannedIpList.push(ip);
        renderBannedIps();
        document.getElementById('banIpInput').value = '';
        addSecurityLog(`تم حظر IP جديد: ${ip}`);
      }
    }

    function renderBannedIps() {
      const ul = document.getElementById('banned-ip-list');
      if (!ul) return;
      ul.innerHTML = bannedIpList.map(ip => `<li>🚫 ${ip}</li>`).join('') || '<li class="text-slate-500">لا يوجد عناوين محظورة حالياً</li>';
    }

    function logout() {
      location.reload();
    }

    // حفظ الرموز السرية دائماً عبر localStorage
    function updateAccountPin() {
      if (!currentUserRole || !currentUserRole.canEdit) return;
      const target = document.getElementById('changePinTarget')?.value;
      const newPin = document.getElementById('newPinInput')?.value.trim();

      if (target && newPin && newPin.length >= 4) {
        ACCOUNTS[target].pin = newPin;
        localStorage.setItem('aegis_accounts', JSON.stringify(ACCOUNTS));
        alert(`✅ تم تغيير الرمز السري بالحفظ الدائم لـ (${ACCOUNTS[target].name})`);
        document.getElementById('newPinInput').value = '';
        addSecurityLog(`تم تغيير رمز PIN للحساب: ${ACCOUNTS[target].name}`);
      } else {
        alert("⚠️ يرجى إدخال رمز مكون من 4 أرقام على الأقل!");
      }
    }

    function saveSystemSettings() {
      if (!currentUserRole || !currentUserRole.canEdit) return;
      const title = document.getElementById('editSystemTitle')?.value || "";
      const sup = document.getElementById('editSupervisor')?.value || "";
      const stud = document.getElementById('editStudents')?.value || "";

      document.querySelectorAll('.system-title-text').forEach(e => e.innerText = title);
      if (document.getElementById('doc-title')) document.getElementById('doc-title').innerText = title;
      if (document.getElementById('supervisor-display')) document.getElementById('supervisor-display').innerText = sup;
      if (document.getElementById('students-display')) document.getElementById('students-display').innerText = stud;

      alert("تم حفظ البيانات وتحديث إعدادات الموقع بنجاح!");
    }

    // ==========================================
    // 2. UI NAVIGATION & TABS
    // ==========================================
    function switchTab(tabId, btn) {
      document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
      document.querySelectorAll('.nav-btn').forEach(el => el.classList.remove('active'));

      const targetTab = document.getElementById(`tab-${tabId}`);
      if (targetTab) targetTab.classList.remove('hidden');
      if (btn) btn.classList.add('active');
    }

    function toggleCollapse(panelId) {
      document.getElementById(panelId)?.classList.toggle('collapsed');
    }

    function hidePanel(panelId) {
      document.getElementById(panelId)?.classList.add('hidden');
    }

    function addSecurityLog(text) {
      const container = document.getElementById('security-logs');
      if (!container) return;
      const div = document.createElement('div');
      div.className = "bg-slate-900/80 p-1.5 rounded border border-cyan-500/20 text-slate-300";
      div.innerHTML = `<span class="text-cyan-400 font-mono">[${new Date().toLocaleTimeString('ar-EG')}]</span> ${text}`;
      container.prepend(div);
    }

    // ==========================================
    // 3. THREE.JS 3D ENGINE & REALISTIC ARCHITECT
    // ==========================================
    let scene, camera, renderer, controls;
    let radarTargetsPool = [];
    let currentFloor = 0;
    let currentRotationAngle = 0;
    let activeCadTool = 'select';
    const cadObjects = [];
    const raycaster = new THREE.Raycaster();
    const mouse = new THREE.Vector2();

    function init3D() {
      const container = document.getElementById('canvas-container');
      if (!container) return;
      container.innerHTML = '';

      scene = new THREE.Scene();
      scene.background = new THREE.Color(0x020617);

      camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 1000);
      camera.position.set(15, 18, 22);

      renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: "high-performance" });
      renderer.setSize(window.innerWidth, window.innerHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.shadowMap.enabled = true;
      renderer.shadowMap.type = THREE.PCFSoftShadowMap;
      container.appendChild(renderer.domElement);

      if (typeof THREE.OrbitControls !== 'undefined') {
        controls = new THREE.OrbitControls(camera, renderer.domElement);
        controls.enableDamping = true;
        controls.dampingFactor = 0.05;
        controls.maxPolarAngle = Math.PI / 2 - 0.01;
      }

      const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
      scene.add(ambientLight);

      const dirLight = new THREE.DirectionalLight(0xffffff, 0.8);
      dirLight.position.set(20, 40, 20);
      dirLight.castShadow = true;
      scene.add(dirLight);

      const gridHelper = new THREE.GridHelper(50, 50, 0x38bdf8, 0x1e293b);
      gridHelper.position.y = -0.01;
      scene.add(gridHelper);

      initMultiTargetSystem();

      window.addEventListener('resize', onWindowResize, false);
      renderer.domElement.addEventListener('pointerdown', onPointerDown, false);

      animate3D();
    }

    function initMultiTargetSystem() {
      radarTargetsPool = [];
      const colors = [0xf43f5e, 0x38bdf8, 0x34d399];
      for (let i = 0; i < 3; i++) {
        const targetGroup = new THREE.Group();
        const marker = new THREE.Mesh(
          new THREE.CylinderGeometry(0.4, 0.4, 0.15, 32),
          new THREE.MeshStandardMaterial({ color: colors[i], emissive: colors[i], emissiveIntensity: 0.6 })
        );
        const body = new THREE.Mesh(new THREE.CylinderGeometry(0.2, 0.12, 1.2, 16), new THREE.MeshStandardMaterial({ color: colors[i] }));
        body.position.y = 0.6;
        const head = new THREE.Mesh(new THREE.SphereGeometry(0.18, 16, 16), new THREE.MeshStandardMaterial({ color: colors[i] }));
        head.position.y = 1.35;

        targetGroup.add(marker, body, head);
        targetGroup.visible = false;
        scene.add(targetGroup);
        radarTargetsPool.push(targetGroup);
      }
    }

    function changeSiteBackground(bgType) {
      if (!scene) return;
      if (bgType === 'dark') { scene.background = new THREE.Color(0x020617); scene.fog = null; }
      else if (bgType === 'sky') { scene.background = new THREE.Color(0x38bdf8); scene.fog = new THREE.FogExp2(0x38bdf8, 0.015); }
      else if (bgType === 'grid') { scene.background = new THREE.Color(0x090d16); scene.fog = new THREE.FogExp2(0x090d16, 0.02); }
    }

    function updateRotationAngle(val) { currentRotationAngle = parseInt(val) || 0; }
    function changeFloor(val) {
      currentFloor = parseInt(val) || 0;
      const hud = document.getElementById('current-floor-hud');
      if (hud) hud.innerText = currentFloor;
    }

    function setCadTool(tool) {
      if (!currentUserRole || !currentUserRole.canEdit) return;
      activeCadTool = tool;
      document.querySelectorAll('.cad-btn').forEach(b => b.classList.remove('active'));
      document.getElementById(`tool-${tool}`)?.classList.add('active');

      const labels = { 'select': 'تحديد', 'wall': 'جدار واقعي', 'door': 'باب خشب', 'window': 'شباك زجاج', 'ai-room': 'غرفة ذكية متكاملة' };
      const labelEl = document.getElementById('active-tool-label');
      if (labelEl) labelEl.innerText = labels[tool] || tool;
    }

    function createCadObject(type, size, pos, rotRad, customColor) {
      let geo, mat, mesh;
      const yPos = (currentFloor * 3) + (type === 'wall' ? 1.5 : (type === 'door' ? 1.25 : 1.2));

      if (type === 'wall') {
        geo = new THREE.BoxGeometry(size.w, 3, size.d);
        mat = new THREE.MeshStandardMaterial({ color: customColor || 0x475569, roughness: 0.5 });
      } else if (type === 'door') {
        geo = new THREE.BoxGeometry(1.2, 2.5, 0.15);
        mat = new THREE.MeshStandardMaterial({ color: 0x92400e, roughness: 0.2 });
      } else if (type === 'window') {
        geo = new THREE.BoxGeometry(1.5, 1.5, 0.1);
        mat = new THREE.MeshPhysicalMaterial({ color: 0x38bdf8, transparent: true, opacity: 0.6 });
      }

      mesh = new THREE.Mesh(geo, mat);
      mesh.position.set(pos.x, yPos, pos.z);
      mesh.rotation.y = rotRad;
      mesh.castShadow = true;
      mesh.userData = { type: type, size: size, customColor: customColor };

      scene.add(mesh);
      cadObjects.push(mesh);
      return mesh;
    }

    function buildAIRoom(centerPos, customSize, customType) {
      const roomType = customType || document.getElementById('aiRoomType')?.value || 'office';
      const sizeVal = customSize || parseFloat(document.getElementById('aiRoomSize')?.value) || 4;
      const half = sizeVal / 2;
      const rotRad = (currentRotationAngle * Math.PI) / 180;

      const roomGroup = new THREE.Group();
      roomGroup.position.set(centerPos.x, currentFloor * 3, centerPos.z);
      roomGroup.rotation.y = rotRad;

      const floorGeo = new THREE.BoxGeometry(sizeVal, 0.1, sizeVal);
      const floorMat = new THREE.MeshStandardMaterial({ color: roomType === 'office' ? 0x1e293b : 0x334155 });
      const floorMesh = new THREE.Mesh(floorGeo, floorMat);
      floorMesh.position.y = 0.05;
      roomGroup.add(floorMesh);

      const wallMat = new THREE.MeshStandardMaterial({ color: roomType === 'office' ? 0x0f172a : 0x475569 });
      const wallThickness = 0.2; const wallHeight = 3;

      const backWall = new THREE.Mesh(new THREE.BoxGeometry(sizeVal, wallHeight, wallThickness), wallMat);
      backWall.position.set(0, wallHeight / 2, -half);
      roomGroup.add(backWall);

      const leftWall = new THREE.Mesh(new THREE.BoxGeometry(wallThickness, wallHeight, sizeVal), wallMat);
      leftWall.position.set(-half, wallHeight / 2, 0);
      roomGroup.add(leftWall);

      const rightWall = new THREE.Mesh(new THREE.BoxGeometry(wallThickness, wallHeight, sizeVal), wallMat);
      rightWall.position.set(half, wallHeight / 2, 0);
      roomGroup.add(rightWall);

      roomGroup.userData = { type: 'ai-room', roomType: roomType, sizeVal: sizeVal };
      scene.add(roomGroup);
      cadObjects.push(roomGroup);
      addSecurityLog(`تم إنشاء غرفة ذكية عند (X:${centerPos.x}, Z:${centerPos.z})`);
      return roomGroup;
    }

    function onPointerDown(event) {
      if (!currentUserRole || !currentUserRole.canEdit || activeCadTool === 'select' || !renderer) return;

      const rect = renderer.domElement.getBoundingClientRect();
      mouse.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
      mouse.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;

      raycaster.setFromCamera(mouse, camera);

      const planeGeo = new THREE.PlaneGeometry(100, 100);
      planeGeo.rotateX(-Math.PI / 2);
      const plane = new THREE.Mesh(planeGeo, new THREE.MeshBasicMaterial({ visible: false }));
      plane.position.y = currentFloor * 3;
      scene.add(plane);

      const intersects = raycaster.intersectObject(plane);
      scene.remove(plane);

      if (intersects.length > 0) {
        const pt = intersects[0].point;
        const snapX = Math.round(pt.x);
        const snapZ = Math.round(pt.z);
        const rotRad = (currentRotationAngle * Math.PI) / 180;

        if (activeCadTool === 'ai-room') {
          buildAIRoom({ x: snapX, z: snapZ });
        } else if (activeCadTool === 'wall') {
          const w = (currentRotationAngle === 90 || currentRotationAngle === 270) ? 0.3 : 3;
          const d = (currentRotationAngle === 90 || currentRotationAngle === 270) ? 3 : 0.3;
          createCadObject('wall', { w: w, d: d }, { x: snapX, z: snapZ }, rotRad);
        } else if (activeCadTool === 'door') {
          createCadObject('door', { w: 1.2, d: 0.2 }, { x: snapX, z: snapZ }, rotRad);
        } else if (activeCadTool === 'window') {
          createCadObject('window', { w: 1.5, d: 0.2 }, { x: snapX, z: snapZ }, rotRad);
        }
      }
    }

    function clearCADObjects() {
      if (!currentUserRole || !currentUserRole.canEdit) return;
      if (confirm("مسح جميع العناصر؟")) {
        cadObjects.forEach(obj => scene.remove(obj));
        cadObjects.length = 0;
        localStorage.removeItem('aegis_cad_layout');
        addSecurityLog("تم مسح جميع المباني.");
      }
    }

    function saveCADDesign() {
      if (!currentUserRole || !currentUserRole.canEdit) return;
      if (cadObjects.length === 0) { alert("⚠️ لا يوجد عناصر للحفظ!"); return; }

      const cadData = cadObjects.map(obj => ({
        type: obj.userData.type,
        roomType: obj.userData.roomType || null,
        sizeVal: obj.userData.sizeVal || null,
        size: obj.userData.size || null,
        customColor: obj.userData.customColor || null,
        position: { x: obj.position.x, z: obj.position.z },
        rotationY: obj.rotation.y
      }));

      localStorage.setItem('aegis_cad_layout', JSON.stringify(cadData));
      alert("✅ تم حفظ تصميم البناء بنجاح!");
      addSecurityLog("💾 تم حفظ تصميم البناء.");
    }

    function loadCADDesign() {
      const savedData = localStorage.getItem('aegis_cad_layout');
      if (!savedData) return;

      try {
        const cadData = JSON.parse(savedData);
        cadData.forEach(item => {
          if (item.type === 'ai-room') {
            buildAIRoom({ x: item.position.x, z: item.position.z }, item.sizeVal, item.roomType);
          } else {
            createCadObject(item.type, item.size, { x: item.position.x, z: item.position.z }, item.rotationY, item.customColor);
          }
        });
      } catch (e) { console.error("Error loading CAD:", e); }
    }

    function updateMultiRadarTargets(targetsArray) {
      radarTargetsPool.forEach(mesh => mesh.visible = false);
      targetsArray.forEach((target, index) => {
        if (index < 3 && target && (target.x !== undefined && target.z !== undefined)) {
          radarTargetsPool[index].position.set(target.x, 0, target.z);
          radarTargetsPool[index].visible = true;
          if (index === 0) {
            const rawXEl = document.getElementById('raw-x');
            const rawZEl = document.getElementById('raw-y');
            const posXEl = document.getElementById('pos-x');
            const posZEl = document.getElementById('pos-z');

            if (rawXEl) rawXEl.innerText = target.x.toFixed(2) + " m";
            if (rawZEl) rawZEl.innerText = target.z.toFixed(2) + " m";
            if (posXEl) posXEl.innerText = target.x.toFixed(2);
            if (posZEl) posZEl.innerText = target.z.toFixed(2);

            updateChartData(target.x, target.z);
          }
        }
      });
    }

    function onWindowResize() {
      if (!camera || !renderer) return;
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    }

    function animate3D() {
      requestAnimationFrame(animate3D);
      if (controls) controls.update();
      if (renderer && scene && camera) renderer.render(scene, camera);
    }

    // ==========================================
    // 4. MEDIAPIPE POSE & CAMERA (حماية الشاشة للآيفون)
    // ==========================================
    let cameraPipe = null;

    function initMediaPipeCamera() {
      const videoElement = document.getElementById('webcam-video');
      const canvasElement = document.getElementById('ai-canvas');
      if (!videoElement || !canvasElement) return;

      videoElement.setAttribute('playsinline', '');
      videoElement.setAttribute('webkit-playsinline', '');
      videoElement.muted = true;

      if (typeof Pose === 'undefined' || typeof Camera === 'undefined') {
        console.warn("MediaPipe CDN لم يتم تحميله بشكل كامل بعد.");
        return;
      }

      try {
        const pose = new Pose({ locateFile: (file) => `https://cdn.jsdelivr.net/npm/@mediapipe/pose/${file}` });
        pose.setOptions({ modelComplexity: 0, smoothLandmarks: true, minDetectionConfidence: 0.5 });

        const canvasCtx = canvasElement.getContext('2d');
        pose.onResults((results) => {
          canvasCtx.save();
          canvasCtx.clearRect(0, 0, canvasElement.width, canvasElement.height);
          canvasCtx.drawImage(results.image, 0, 0, canvasElement.width, canvasElement.height);
          canvasCtx.restore();
        });

        cameraPipe = new Camera(videoElement, {
          onFrame: async () => { await pose.send({ image: videoElement }); },
          width: 320, height: 240, facingMode: 'user'
        });
        cameraPipe.start().catch(err => console.log("الكاميرا في انتظار الإذن:", err));
      } catch(e) { console.error("MediaPipe Init Catch:", e); }
    }

    function startCameraManual() {
      if (cameraPipe) {
        cameraPipe.stop();
        cameraPipe.start().catch(() => alert("⚠️ تأكد من إعطاء إذن الكاميرا!"));
      }
    }

    // ==========================================
    // 5. CHART ANALYTICS
    // ==========================================
    let chartInstance = null;

    function initChart() {
      const el = document.getElementById('analyticsChart');
      if (!el || typeof Chart === 'undefined') return;
      const ctx = el.getContext('2d');
      chartInstance = new Chart(ctx, {
        type: 'line',
        data: {
          labels: ['0s', '1s', '2s', '3s', '4s', '5s'],
          datasets: [{ label: 'المسافة (m)', data: [0, 0, 0, 0, 0, 0], borderColor: '#38bdf8', fill: true }]
        },
        options: { responsive: true, maintainAspectRatio: false }
      });
    }

    function updateChartData(x, z) {
      if (!chartInstance) return;
      const distance = Math.sqrt(x * x + z * z);
      const labels = chartInstance.data.labels;
      const data = chartInstance.data.datasets[0].data;

      labels.shift(); labels.push(new Date().toLocaleTimeString('ar-EG').split(' ')[0]);
      data.shift(); data.push(distance);
      chartInstance.update();
    }

    // ==========================================
    // 6. FACE CAPTURE & DATABASE
    // ==========================================
    let faceDatabase = [];

    function loadFacesGallery() {
      try {
        const storedFaces = localStorage.getItem('aegis_faces_db');
        if (storedFaces) {
          faceDatabase = JSON.parse(storedFaces);
          renderFacesGallery();
        }
      } catch(e) {}
    }

    function captureFace() {
      if (!currentUserRole || !currentUserRole.canEdit) return;
      const name = document.getElementById('faceNameInput')?.value.trim();
      if (!name) { alert("أدخل اسم الشخص أولاً!"); return; }

      const canvas = document.getElementById('ai-canvas');
      if (!canvas) return;

      const faceEntry = { id: Date.now(), name: name, image: canvas.toDataURL('image/png') };
      faceDatabase.push(faceEntry);
      localStorage.setItem('aegis_faces_db', JSON.stringify(faceDatabase));

      renderFacesGallery();
      document.getElementById('faceNameInput').value = '';
      alert(`✅ تم حفظ الصورة بنجاح!`);
    }

    function renderFacesGallery() {
      const container = document.getElementById('faces-gallery');
      if (!container) return;
      container.innerHTML = faceDatabase.map(item => `
        <div class="bg-slate-950 p-1 rounded border border-slate-800 text-center relative group">
          <img src="${item.image}" class="w-full h-16 object-cover rounded mb-1">
          <span class="text-[9px] text-cyan-300 font-bold block truncate">${item.name}</span>
          <button onclick="deleteFace(${item.id})" class="text-[8px] bg-red-600 text-white px-1 rounded absolute top-0.5 right-0.5">✕</button>
        </div>
      `).join('');
    }

    function deleteFace(id) {
      if (!currentUserRole || !currentUserRole.canEdit) return;
      faceDatabase = faceDatabase.filter(item => item.id !== id);
      localStorage.setItem('aegis_faces_db', JSON.stringify(faceDatabase));
      renderFacesGallery();
    }

    // ==========================================
    // 7. MQTT SENSOR REAL CONNECT (استقبال الإحداثيات الحقيقية)
    // ==========================================
    let mqttClient = null;

    function initMQTT() {
      if (typeof mqtt === 'undefined') return;
      try {
        mqttClient = mqtt.connect('wss://broker.hivemq.com:8884/mqtt');
        mqttClient.on('connect', () => {
          mqttClient.subscribe('aegisradar/radar/data');
          addSecurityLog("تم الاتصال بخادم الرادار المباشر (MQTT WebSocket).");
        });
        mqttClient.on('message', (topic, message) => {
          try {
            const data = JSON.parse(message.toString());
            if (data && data.targets) {
              updateMultiRadarTargets(data.targets);
            }
          } catch (e) {}
        });
      } catch(e) {}
    }

    function connectMQTT() {
      const btn = document.getElementById('sensor-btn');
      if (!btn) return;
      btn.innerHTML = `جاري الاتصال...`;
      if (!mqttClient || !mqttClient.connected) {
        initMQTT();
      }
      setTimeout(() => {
        btn.innerHTML = `<i class="fa-solid fa-plug text-amber-300"></i> الرادار متصل`;
      }, 1200);
    }
  </script>
</body>
