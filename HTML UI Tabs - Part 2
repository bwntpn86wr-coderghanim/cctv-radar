            </button>
          </div>

          <div class="pt-2 border-t border-slate-800">
            <span class="text-[10px] text-slate-400 block mb-1">الوجوه المحفوظة بالنظام:</span>
            <div id="faces-gallery" class="grid grid-cols-3 gap-1.5 max-h-40 overflow-y-auto"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- TAB 4: DANGER ZONES & IP AUDIT -->
    <div id="tab-security" class="tab-content hidden relative z-10 pointer-events-none w-full h-full">
      <div id="panel-security" class="absolute top-16 right-2 left-2 sm:left-auto sm:w-80 pointer-events-auto glass-panel p-3 flex flex-col gap-2 max-h-[82vh] overflow-y-auto">
        <div class="flex justify-between items-center border-b border-slate-800 pb-1">
          <h3 class="text-xs font-bold text-red-400 flex items-center gap-1"><i class="fa-solid fa-user-shield"></i> الأمان وحظر العناوين (IP Blacklist)</h3>
          <div class="flex items-center gap-1">
            <button onclick="toggleCollapse('panel-security')" class="text-slate-400 hover:text-white text-xs px-1"><i class="fa-solid fa-minus"></i></button>
            <button onclick="hidePanel('panel-security')" class="text-slate-400 hover:text-red-400 text-xs px-1"><i class="fa-solid fa-xmark"></i></button>
          </div>
        </div>
        
        <div class="panel-content space-y-3 text-xs">
          <!-- Audit Access Logs -->
          <div>
            <span class="text-[10px] text-cyan-400 font-bold block mb-1">🔍 سجل المتواجدين ومن دخل للموقع:</span>
            <div id="login-audit-logs" class="bg-slate-950 p-2 rounded border border-slate-800 h-28 overflow-y-auto font-mono text-[9px] space-y-1"></div>
          </div>

          <!-- IP Ban Manager (Admin Only) -->
          <div class="admin-only-container border-t border-slate-800 pt-2 space-y-1.5">
            <span class="text-[10px] text-red-400 font-bold block">🚫 حظر عنوان IP:</span>
            <input type="text" id="banIpInput" placeholder="أدخل IP لحظره (مثال: 192.168.1.5)" class="w-full bg-slate-900 border border-slate-700 p-1.5 rounded text-slate-200">
            <button onclick="banIpAddress()" class="w-full bg-red-600 hover:bg-red-500 text-white p-1.5 rounded font-bold transition">
              حظر العنوان الآن 🛑
            </button>
            
            <div class="mt-2">
              <span class="text-[9px] text-slate-400 block mb-1">قائمة العناوين المحظورة:</span>
              <ul id="banned-ip-list" class="text-[10px] text-red-400 space-y-0.5 bg-slate-950 p-1.5 rounded border border-slate-800"></ul>
            </div>
          </div>

          <!-- Geofencing -->
          <div class="admin-only-container border-t border-slate-800 pt-2 space-y-1.5">
            <span class="text-[10px] text-amber-400 font-bold block">🚨 إضافة منطقة خطر (Geofencing):</span>
            <input type="text" id="zoneName" placeholder="اسم المنطقة" value="منطقة محظورة" class="w-full bg-slate-900 border border-slate-700 p-1 rounded text-slate-200">
            <div class="grid grid-cols-2 gap-1.5">
              <input type="number" id="zoneX" placeholder="X" value="0" class="bg-slate-900 border border-slate-700 p-1 rounded text-slate-200">
              <input type="number" id="zoneZ" placeholder="Z" value="0" class="bg-slate-900 border border-slate-700 p-1 rounded text-slate-200">
            </div>
            <button onclick="addDangerZoneUI()" class="w-full bg-amber-600 hover:bg-amber-500 text-white p-1.5 rounded font-bold transition">
              إنشاء منطقة الخطر
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- TAB 5: SYSTEM SETTINGS & PIN MANAGEMENT -->
