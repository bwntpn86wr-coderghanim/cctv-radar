    <!-- TAB 2: ADVANCED REALISTIC ARCHITECT -->
    <div id="tab-architect" class="tab-content hidden relative z-10 pointer-events-none w-full h-full">
      <div id="panel-architect" class="absolute top-16 right-2 left-2 sm:left-auto sm:w-80 pointer-events-auto glass-panel p-3 flex flex-col gap-2 max-h-[82vh] overflow-y-auto">
        <div class="flex justify-between items-center border-b border-slate-800 pb-1">
          <h3 class="text-xs font-bold text-cyan-400 flex items-center gap-1"><i class="fa-solid fa-wand-magic-sparkles text-amber-300"></i> البناء الهندسي الواقعي (3D)</h3>
          <div class="flex items-center gap-1">
            <button onclick="toggleCollapse('panel-architect')" class="text-slate-400 hover:text-white text-xs px-1"><i class="fa-solid fa-minus"></i></button>
            <button onclick="hidePanel('panel-architect')" class="text-slate-400 hover:text-red-400 text-xs px-1"><i class="fa-solid fa-xmark"></i></button>
          </div>
        </div>
        
        <div class="panel-content space-y-2 admin-only-container">
          <!-- Floor, Angle & Background Controls -->
          <div class="grid grid-cols-2 gap-1.5 text-xs">
            <div>
              <label class="block text-slate-400 text-[9px] mb-0.5">الطابق الحالي:</label>
              <select id="floorSelect" onchange="changeFloor(this.value)" class="w-full bg-slate-900 border border-slate-700 p-1 rounded text-cyan-400 font-bold text-xs">
                <option value="0">الأرضي (0)</option>
                <option value="1">الأول (1)</option>
                <option value="2">الثاني (2)</option>
              </select>
            </div>
            <div>
              <label class="block text-slate-400 text-[9px] mb-0.5">اتجاه التدوير (زاوية):</label>
              <select id="angleSelect" onchange="updateRotationAngle(this.value)" class="w-full bg-slate-900 border border-slate-700 p-1 rounded text-emerald-400 font-bold text-xs">
                <option value="0">0° (أفقي)</option>
                <option value="45">45° (قطري)</option>
                <option value="90">90° (عمودي)</option>
                <option value="135">135° (معاكس)</option>
              </select>
            </div>
          </div>

          <!-- Site Background Selection -->
          <div>
            <label class="block text-slate-400 text-[9px] mb-0.5">خلفية ورؤية الموقع:</label>
            <select id="bgSelect" onchange="changeSiteBackground(this.value)" class="w-full bg-slate-900 border border-slate-700 p-1 rounded text-amber-300 font-bold text-xs">
              <option value="dark">النمط الليلي الأمني (Cyber Dark)</option>
              <option value="sky">السماء الواقعية (Realistic Sky)</option>
              <option value="grid">الفضاء الشبكي (Blueprint Grid)</option>
            </select>
          </div>

          <!-- AI Advanced Architect Suite -->
          <div class="bg-gradient-to-b from-slate-900 to-slate-950 p-2.5 rounded-lg border border-cyan-500/40 text-xs space-y-2">
            <span class="text-cyan-300 font-bold block text-[11px]"><i class="fa-solid fa-house-chimney text-amber-400 ml-1"></i> مولّد الغرف والأبنية:</span>
            
            <div>
              <label class="text-[9px] text-slate-400 block mb-0.5">نوع التصميم:</label>
              <select id="aiRoomType" class="w-full bg-slate-950 border border-slate-700 rounded p-1 text-[11px] text-slate-200">
                <option value="living">غرفة معيشة متكاملة (جدران + أبواب + نوافذ)</option>
                <option value="office">مكتب أمني مغلق (جدران سميكة + باب)</option>
                <option value="hall">صالة زجاجية مفتوحة (واجهة زجاجية)</option>
              </select>
            </div>

            <div>
              <label class="text-[9px] text-slate-400 block mb-0.5">المساحة:</label>
              <select id="aiRoomSize" class="w-full bg-slate-950 border border-slate-700 rounded p-1 text-[11px] text-slate-200">
                <option value="4">صغيرة (4x4 م)</option>
                <option value="6" selected>متوسطة (6x6 م)</option>
                <option value="8">كبيرة (8x8 م)</option>
              </select>
            </div>

            <button id="tool-ai-room" onclick="setCadTool('ai-room')" class="cad-btn w-full bg-gradient-to-r from-cyan-600 to-blue-600 hover:from-cyan-500 hover:to-blue-500 p-2 rounded text-white font-bold text-xs flex items-center justify-center gap-1 shadow-lg shadow-cyan-500/20">
              <i class="fa-solid fa-wand-magic-sparkles"></i> انقر على الخريطة للتشييد
            </button>
          </div>

          <!-- Manual CAD Tools -->
          <span class="text-[10px] text-slate-400 block pt-1">أدوات البناء اليدوي:</span>
          <div id="cad-tools-panel" class="grid grid-cols-2 gap-1.5">
            <button id="tool-select" onclick="setCadTool('select')" class="cad-btn active p-1.5 rounded text-xs font-semibold flex items-center gap-1 justify-center"><i class="fa-solid fa-arrow-pointer text-cyan-400"></i> تحديد</button>
            <button id="tool-wall" onclick="setCadTool('wall')" class="cad-btn p-1.5 rounded text-xs font-semibold flex items-center gap-1 justify-center"><i class="fa-solid fa-cube text-emerald-400"></i> جدار واقعي</button>
            <button id="tool-door" onclick="setCadTool('door')" class="cad-btn p-1.5 rounded text-xs font-semibold flex items-center gap-1 justify-center"><i class="fa-solid fa-door-closed text-amber-300"></i> باب خشب</button>
            <button id="tool-window" onclick="setCadTool('window')" class="cad-btn p-1.5 rounded text-xs font-semibold flex items-center gap-1 justify-center"><i class="fa-solid fa-window-restore text-cyan-300"></i> شباك زجاج</button>
          </div>

          <button onclick="clearCADObjects()" class="w-full bg-red-950/40 hover:bg-red-900/60 text-red-300 p-1.5 rounded text-xs font-semibold border border-red-800/50 mt-1">
            <i class="fa-solid fa-trash-can ml-1"></i> مسح جميع المجسمات
          </button>
        </div>
      </div>
    </div>

    <!-- TAB 3: FACE CAPTURE & DATABASE -->
    <div id="tab-faces" class="tab-content hidden relative z-10 pointer-events-none w-full h-full">
      <div id="panel-faces" class="absolute top-16 right-2 left-2 sm:left-auto sm:w-80 pointer-events-auto glass-panel p-3 flex flex-col gap-2 max-h-[80vh] overflow-y-auto">
        <div class="flex justify-between items-center border-b border-slate-800 pb-1">
